# Server
PORT=3000
NODE_ENV=development

# Dataset and storage
DATASET_PATH=dataset/surgical_device_dataset_v2_enriched.json
EMBEDDING_CACHE_PATH=storage/embedding_cache.json
FEEDBACK_LOG_PATH=storage/feedback_log.jsonl

# Embedding provider
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=

# Gemini embedding provider from Google AI Studio
GEMINI_API_KEY=replace_with_google_ai_studio_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional lower dimension, e.g. 768, 1536, or 3072. Leave empty for default.
GEMINI_OUTPUT_DIMENSIONALITY=
GEMINI_TASK_TYPE=SEMANTIC_SIMILARITY

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=surgical_devices_v1
QDRANT_DISTANCE=Cosine

# Search behavior
SEARCH_TOP_K=20
RETURN_LIMIT=3

# Debugging
SHOW_DEBUG=true
